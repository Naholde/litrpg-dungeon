   "lore": [
    {
     "box": [
      1046,
      63,
      12,
      1070,
      73,
      42
     ],
     "text": "Система: «Здесь лежат те, кто вошёл до вас. Склеп помнит каждого — и не любит, когда его тревожат.»"
    },
    {
     "box": [
      1094,
      63,
      24,
      1098,
      68,
      30
     ],
     "text": "Система: «Полосы на полу вспыхивают по очереди. Идите за погасшими.»"
    },
    {
     "box": [
      1120,
      63,
      13,
      1148,
      74,
      41
     ],
     "text": "Система: «Привратник не пропускает живых. Стойте за спиной у того, кто держит его взгляд.»"
    },
    {
     "box": [
      1164,
      55,
      14,
      1188,
      64,
      40
     ],
     "text": "Система: «Три плиты в трёх концах зала. Одному их не удержать — придётся разделиться.»"
    },
    {
     "box": [
      1170,
      55,
      44,
      1184,
      62,
      56
     ],
     "text": "Система: «Костолом собирает кости тех, кто сюда забрёл. Его ключ откроет его же сундук.»"
    },
    {
     "box": [
      1235,
      55,
      2,
      1265,
      66,
      32
     ],
     "text": "Система: «Сёстры Морра и Весса. Пала одна — вторая её поднимет. Убейте их вместе.»"
    },
    {
     "box": [
      1272,
      55,
      10,
      1284,
      62,
      24
     ],
     "text": "Система: «Алтарь задаёт вопрос. Ответ напишите в чат, стоя рядом.»"
    },
    {
     "box": [
      1291,
      55,
      2,
      1321,
      67,
      32
     ],
     "text": "Система: «Король-лич Карн. Когда погаснет свет — держитесь у душевных жаровен.»"
    }
   ],

   "lore": [
    {
     "box": [
      2048,
      63,
      22,
      2065,
      72,
      38
     ],
     "text": "Система: «Здесь когда-то был лес. Теперь он растёт вниз — и ест тех, кто растёт вверх.»"
    },
    {
     "box": [
      2094,
      63,
      10,
      2122,
      77,
      34
     ],
     "text": "Система: «Паучьи ясли. Не рвите паутину без нужды — по ней бегут вести к Королеве.»"
    },
    {
     "box": [
      2127,
      63,
      13,
      2145,
      74,
      31
     ],
     "text": "Система: «Нажмите кнопку в пне и запомните, какие грибы вспыхнут. Потом — по порядку.»"
    },
    {
     "box": [
      2148,
      63,
      7,
      2177,
      76,
      37
     ],
     "text": "Система: «Королева Аракна. Яйца — разбить. Коконы — разрезать. Когда она уходит под своды — не стойте под ней.»"
    },
    {
     "box": [
      2182,
      63,
      12,
      2188,
      72,
      32
     ],
     "text": "Система: «Мост из корней. Споры вспыхивают по очереди. Упадёте — Система вытащит, но не бесплатно.»"
    },
    {
     "box": [
      2214,
      63,
      10,
      2238,
      74,
      34
     ],
     "text": "Система: «Логово ведьм. Книга на аналое загадывает загадку — ответ напишите в чат, стоя рядом.»"
    },
    {
     "box": [
      2243,
      63,
      6,
      2274,
      76,
      38
     ],
     "text": "Система: «Гнилой Древень. Споры растут — уводите его от них. Сердцевину — сбить.»"
    },
    {
     "box": [
      2303,
      63,
      7,
      2333,
      75,
      37
     ],
     "text": "Система: «Морена. Испуганного — не оставляйте одного. На Изнанке земля выворачивается: к ней — от неё — к ней.»"
    }
   ],
